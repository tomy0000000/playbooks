#!/usr/bin/env bash
set -euo pipefail
umask 077

mount={{ backup_mount }}
stamp=$(date -u +%Y%m%dT%H%M%SZ)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
dump_dir=$work/dump
archive=$work/$stamp.tar.gz

mkdir "$dump_dir"
{{ backup_dump | default(':') }}
tar -czf "$archive" -C "$dump_dir" . -C / {{ backup_paths | map('regex_replace', '^/', '') | map('quote') | join(' ') }}

# Upload first so a missing backup disk still leaves an offsite copy
rclone --config "$CREDENTIALS_DIRECTORY/rclone.conf" copyto "$archive" "r2:{{ backup_bucket }}/$stamp.tar.gz"

mountpoint -q "$mount" || { echo "$mount is not mounted" >&2; exit 1; }
mkdir -p "$mount/{{ backup_name }}"
cp "$archive" "$mount/{{ backup_name }}/"
find "$mount/{{ backup_name }}" -name '*.tar.gz' -mtime +30 -delete
